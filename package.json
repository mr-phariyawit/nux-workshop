{
  "name": "nux-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NUX Design course homework: Markdown contracts, a11y workshop, and a read-only design-system MCP server",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test tests/session-3/*.test.ts",
    "test:e2e": "node --import tsx --test tests/session-2/*.test.ts",
    "mcp:sitops": "tsx src/mcp/sitops-design-system/server.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.4",
    "playwright": "^1.56.1",
    "playwright-core": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
